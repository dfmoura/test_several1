# Virada homolog → produção (chave final).
#   1. Snapshot Lightsail + dump MySQL
#   2. cp .env.aws.production.example .env.aws   (ou edite o .env.aws atual)
#   3. make aws-check && make up-aws
#   4. Confirme GET /api/v1/health → "stage":"production"
#
# Host oficial desta instalação: https://flexoerp001.triggerti.com
#   docs/ADR_HOST_INSTALACAO_FLEXOERP001.md
# NÃO usar flexorc.triggerti.com aqui (isso é tunnel de lab no notebook).
# NÃO commitar .env.aws
# PRESERVE APP_KEY se o banco já tem A1/Focus cifrados.

APP_NAME=FLEXOERP
ERP_STAGE=production
APP_ENV=production
APP_KEY=
# OBRIGATÓRIO: mesma APP_KEY da homolog se mantiver dados cifrados (A1/IA/Focus).
# Se for banco NOVO, gere chave nova e não reutilize tokens/PFX cifrados antigos.
APP_DEBUG=false
APP_URL=https://flexoerp001.triggerti.com
FRONTEND_URL=https://flexoerp001.triggerti.com
ORCAMENTO_PUBLIC_BASE_URL=https://flexoerp001.triggerti.com

WEB_PORT=80
SEED_ON_BOOT=false

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=TROCAR_SENHA_FORTE_PRODUCAO
DB_ROOT_PASSWORD=TROCAR_ROOT_FORTE_PRODUCAO

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

SANCTUM_STATEFUL_DOMAINS=flexoerp001.triggerti.com

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=TROCAR_ADMIN_FORTE_PRODUCAO
# Em produção: desative usuários demo ou troque senhas após 1º acesso
DEMO_PASSWORD=TROCAR_OU_DESATIVE_DEMOS

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws
OPENCEP_BASE=https://opencep.com/v1
CEP_HTTP_TIMEOUT_SEC=5
ORS_API_KEY=
ORS_BASE=https://api.openrouteservice.org
ORS_HTTP_TIMEOUT_SEC=8
IA_HTTP_TIMEOUT_SEC=45
FISCAL_EMISSOR=focus

# --- Envio da proposta (ORC) — OBRIGATÓRIO em produção ---
# Mesmos valores do motor local (apps/api/.env), colados AQUI — nunca no git.
# Após up-aws: curl …/api/v1/health → envio_proposta.viazap_configurado=true
#             e envio_proposta.mail_smtp_pronto=true
ORCAMENTO_EMAIL_AUTO=true
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

ORCAMENTO_WHATSAPP_AUTO=true
VIAZAP_BASE_URL=https://viazap.triggerti.com
VIAZAP_TOKEN=
VIAZAP_TIMEOUT_SEC=20
