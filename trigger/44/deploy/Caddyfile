{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Evolution fala com a API na rede Docker (api:8000). Na internet pública
	# este path não deve existir — evita spoof de CONNECTION_UPDATE.
	@evolution_public path /v1/webhooks/evolution /v1/webhooks/evolution/*
	respond @evolution_public 404

	reverse_proxy api:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}
