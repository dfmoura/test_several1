# Valores locais. Na publicação, substituir antes do primeiro start.
# O volume do Postgres só aplica senha de papel na inicialização.
POSTGRES_PASSWORD=osb_local
APP_DB_PASSWORD=osb_local_app
MIGRATION_DB_PASSWORD=osb_local_mig

# HTTP local. Em HTTPS na VM, usar auto.
AUTH_COOKIE_SECURE=0

# Primeira conta master. Deixe vazio no repositório; preencha só na máquina.
BOOTSTRAP_USUARIO=
BOOTSTRAP_SENHA=

# Faixas C e D permanecem desligadas na v1.
FAIXA_C_HABILITADA=0
FAIXA_D_HABILITADA=0

# Só para o profile https, no dia da publicação. Não inventar domínio.
# DOMAIN=
