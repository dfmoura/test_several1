generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papel de autenticação no sistema (controle de acesso).
enum Role {
  ADMIN
  VENDEDOR
  ORCAMENTISTA
  PCP
  COMPRAS
  FINANCEIRO
  EXPEDICAO
}

enum OrcamentoStatus {
  RASCUNHO
  ENVIADO
  /// Cliente abriu o link de aprovação (estudo APROVACAO_ORCAMENTO_CLIENTE).
  VISUALIZADO
  APROVADO
  REPROVADO
  /// Legado — tratado como REPROVADO na UI/regras.
  PERDIDO
}

/// Pessoa física ou jurídica do parceiro comercial.
enum TipoPessoa {
  PF
  PJ
}

/// Natureza comercial do parceiro. Um mesmo registro pode acumular vários tipos
/// (ex.: cliente + fornecedor, vendedor + usuário do sistema).
enum TipoParceiro {
  CLIENTE
  FORNECEDOR
  VENDEDOR
  USUARIO
}

/// Ambiente fiscal da empresa emitente (homologação ≈ teste; produção = real).
enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO
  LUCRO_PRESUMIDO
  LUCRO_REAL
  MEI
  OUTRO
}

/// Tipo de certificado digital ICP-Brasil.
enum TipoCertificado {
  A1
  A3
}

enum FinalidadeCertificado {
  NFSE
  NFE
  CTE
  GERAL
}

enum StatusCertificado {
  ATIVO
  VENCIDO
  REVOGADO
  PENDENTE
}

/// Classificação CNAE da empresa (RFB).
enum TipoCnae {
  PRINCIPAL
  SECUNDARIO
}

/// Tipo de série/numeração fiscal controlada pelo ERP.
enum SerieDocumentoTipo {
  NFE
  NFSE_DPS
}

/// Indicador de IE do destinatário (NF-e indIEDest).
/// 1 = Contribuinte ICMS | 2 = Isento | 9 = Não contribuinte
enum IndicadorIeDest {
  CONTRIBUINTE
  ISENTO
  NAO_CONTRIBUINTE
}

/// Raiz do sistema: cadastro único da empresa emitente (matriz/filial).
/// Em fase 1 opera como single-tenant; o modelo já admite filiais (parentId).
model Empresa {
  id                     String           @id @default(cuid())
  codigo                 String?          @unique
  razaoSocial            String
  nomeFantasia           String
  cnpj                   String           @unique
  inscricaoEstadual      String?
  inscricaoMunicipal     String?
  /// Denormalizado do CNAE PRINCIPAL (só dígitos) — atalho para PDF/relatórios.
  cnaePrincipal          String?
  cnaePrincipalDescricao String?
  regimeTributario       RegimeTributario  @default(SIMPLES_NACIONAL)
  email                  String?
  telefone               String?
  celular                String?
  website                String?
  cep                    String?
  logradouro             String?
  numero                 String?
  complemento            String?
  bairro                 String?
  cidade                 String?
  uf                     String?
  codigoMunicipioIbge    String?
  logoUrl                String?
  /// Ambiente fiscal efetivo (teste pode simular PRODUCAO sem emitir de fato).
  ambienteFiscal         AmbienteFiscal   @default(HOMOLOGACAO)
  /// Quando true, UI/APIs tratam como se fosse produção (sem side-effects fiscais reais).
  simularProducao        Boolean          @default(true)
  isMatriz               Boolean          @default(true)
  /// EMP principal de operação (vitrine / default de login). Spec EMP-00001.
  operacionalPrincipal   Boolean          @default(false)
  /// Permite PED/ORC/NF de venda neste CNPJ. EMP-00002 = false até parecer Contador+Direção.
  vendaHabilitada        Boolean          @default(true)
  parentId               String?
  ativo                  Boolean          @default(true)
  observacoes            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  parent       Empresa?             @relation("EmpresaFiliais", fields: [parentId], references: [id])
  filiais      Empresa[]            @relation("EmpresaFiliais")
  cnaes       EmpresaCnae[]
  certificados EmpresaCertificado[]
  users          User[]
  parceiros      Parceiro[]
  orcamentos     Orcamento[]
  parametros     ParametroSistema[]
  produtos       Produto[]
  depositos      Deposito[]
  pedidosVenda   PedidoVenda[]
  pedidosCompra  PedidoCompra[]
  integracoes    EmpresaIntegracao[]
  docsEntrada    DocumentoFiscalEntrada[]
  docsSaida      DocumentoFiscalSaida[]
  naturezasOperacao NaturezaOperacao[]
  seriesDocumento SerieDocumentoFiscal[]
  parametroFiscal ParametroFiscalEmpresa?
  contasBancarias ContaBancaria[]
  titulosReceber  TituloReceber[]
  titulosPagar    TituloPagar[]
  movimentosBancarios MovimentoBancario[]

  @@index([ativo])
  @@index([nomeFantasia])
  @@index([isMatriz])
}

/// CNAEs da empresa (1 principal + N secundários). Fonte de verdade fiscal.
model EmpresaCnae {
  id          String   @id @default(cuid())
  empresaId   String
  /// Código CNAE só dígitos (7).
  codigo      String
  descricao   String?
  tipo        TipoCnae
  /// Ordem de exibição (0 = principal).
  ordem       Int      @default(0)
  ativo       Boolean  @default(true)
  /// Origem: brasilapi | minhareceita | manual
  fonte       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo])
  @@index([codigo])
}

/// Certificado digital vinculado à empresa (metadados + arquivo opcional cifrado).
/// Em ambiente de teste o arquivo pode ficar ausente (status PENDENTE) para simular o fluxo.
model EmpresaCertificado {
  id                 String               @id @default(cuid())
  empresaId          String
  apelido            String
  tipo               TipoCertificado      @default(A1)
  finalidade         FinalidadeCertificado @default(GERAL)
  status             StatusCertificado    @default(PENDENTE)
  subjectCn          String?
  serialNumber       String?
  emissor            String?
  validadeInicio     DateTime?
  validadeFim        DateTime?
  arquivoNome        String?
  /// SHA-256 do conteúdo (quando houver upload).
  arquivoFingerprint String?
  /// Conteúdo .pfx/.p12 cifrado (AES-GCM); null = só metadados / simulação.
  arquivoCifrado     Bytes?
  /// Senha do PFX cifrada; nunca em texto puro.
  senhaCifrada       Bytes?
  ativo              Boolean              @default(true)
  observacoes        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, ativo])
  @@index([finalidade])
  @@index([validadeFim])
  @@unique([empresaId, apelido])
}

/// Credenciais de acesso. Isoladas do cadastro comercial por segurança.
/// Quando o parceiro tem tipo USUARIO, liga-se 1:1 via parceiroId.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VENDEDOR)
  active       Boolean  @default(true)
  /// Escopo na empresa raiz (single-tenant hoje; multi-tenant pronto).
  empresaId    String?
  parceiroId   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresa              Empresa?    @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  parceiro             Parceiro?   @relation(fields: [parceiroId], references: [id], onDelete: SetNull)
  orcamentos           Orcamento[] @relation("CreatedBy")
  orcamentosDecididos  Orcamento[] @relation("OrcamentoDecididoPor")
  auditLogs            AuditLog[]

  @@index([empresaId])
}

/// Entidade mestre de parceiros (Party Pattern / Business Partner).
/// Unifica clientes, fornecedores, vendedores e usuários do sistema.
/// `codigo` = chave de negócio numérica (imutável após criação; única por empresa).
model Parceiro {
  id          String     @id @default(cuid())
  empresaId   String?
  /// Código interno ERP numérico (ex.: 0001). Obrigatório; sequencial por empresa.
  codigo      String
  tipoPessoa  TipoPessoa @default(PJ)
  nome        String
  razaoSocial String?
  documento   String?
  email       String?
  /// E-mail preferencial para envio fiscal (Focus email_destinatario / email_tomador).
  emailFiscal String?
  telefone    String?
  celular     String?
  website     String?
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?
  /// Código IBGE do município (7 dígitos) — obrigatório para NF-e/NFS-e.
  codigoMunicipioIbge String?
  /// Código país BACEN (1058 = Brasil).
  paisCodigo  String     @default("1058")
  inscricaoEstadual   String?
  inscricaoMunicipal  String?
  /// indIEDest Focus: CONTRIBUINTE=1 | ISENTO=2 | NAO_CONTRIBUINTE=9
  indicadorIeDest     IndicadorIeDest @default(NAO_CONTRIBUINTE)
  contribuinteIcms    Boolean  @default(false)
  /// consumidor_final na NF-e (0/1).
  consumidorFinal     Boolean  @default(false)
  /// Limite de crédito em R$ (obrigatório; padrão 0 = só à vista/antecipado).
  limiteCredito       Decimal  @default(0) @db.Decimal(14, 2)
  /// Situação do motor de crédito (calculada; BLOQUEIO_MANUAL é setável).
  situacaoCredito     SituacaoCreditoCliente @default(NORMAL)
  /// Condição máxima autorizada (ex.: "28 DDL").
  condicaoPagamentoMax String?
  /// Validade da última análise de crédito.
  creditoValidoAte    DateTime?
  observacoes String?
  ativo       Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  empresa                Empresa?      @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  tipos                  ParceiroTipo[]
  user                   User?
  orcamentosComoCliente  Orcamento[] @relation("OrcamentoCliente")
  orcamentosComoVendedor Orcamento[] @relation("OrcamentoVendedor")
  pedidosComoCliente     PedidoVenda[] @relation("PedidoCliente")
  pedidosComoVendedor    PedidoVenda[] @relation("PedidoVendedor")
  pedidosCompra          PedidoCompra[] @relation("PedidoCompraFornecedor")
  produtosFornecedor     ProdutoFornecedor[]
  titulosAdiantamento    TituloReceber[] @relation("TituloAdiantamentoCliente")

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([codigo])
  @@index([nome])
  @@index([documento])
  @@index([ativo])
  @@index([cidade, uf])
  @@index([codigoMunicipioIbge])
  @@index([situacaoCredito])
}

/// Papéis comerciais atribuídos ao parceiro (N:N tipado).
model ParceiroTipo {
  id                String       @id @default(cuid())
  parceiroId        String
  tipo              TipoParceiro
  /// Comissão padrão sugerida no orçamento (apenas VENDEDOR).
  comissaoPadraoPct Decimal?     @db.Decimal(5, 2)
  ativo             Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parceiro Parceiro @relation(fields: [parceiroId], references: [id], onDelete: Cascade)

  @@unique([parceiroId, tipo])
  @@index([tipo])
}

model Papel {
  id        String   @id @default(cuid())
  nome      String   @unique
  precoM2   Decimal  @db.Decimal(12, 4)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[] @relation("ProdutoPapel")
}

model Acabamento {
  id        String   @id @default(cuid())
  nome      String   @unique
  precoM2   Decimal  @db.Decimal(12, 4)
  perdaM2   Decimal  @default(0) @db.Decimal(12, 4)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[] @relation("ProdutoAcabamento")
}

model Tubete {
  id        String   @id @default(cuid())
  tamanho   String   @unique
  nome      String?
  preco     Decimal  @db.Decimal(12, 4)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtos Produto[] @relation("ProdutoTubete")
}

model HoraParada {
  id       String  @id @default(cuid())
  tipo     String  @unique
  tempoH   Decimal @db.Decimal(12, 6)
  tempoMin Int?
  ativo    Boolean @default(true)
}

model Maquina {
  id    String  @id @default(cuid())
  nome  String  @unique
  grupo String
  ativo Boolean @default(true)
}

model HoraMaquinaTarifa {
  id     String  @id @default(cuid())
  grupo  String
  cores  String
  tarifa Decimal @db.Decimal(12, 4)

  @@unique([grupo, cores])
}

model PerdaPapel {
  id     String   @id @default(cuid())
  cores  String   @unique
  m2Fixo Decimal? @db.Decimal(12, 4)
  fator  Decimal? @db.Decimal(12, 4)
}

model CaixaLookup {
  id         String @id @default(cuid())
  chave      String @unique
  qtdeCaixas Int
}

model Faca {
  id         String   @id @default(cuid())
  maquina    String?
  conjugada  String?
  fornecedor String?
  numero     String?
  z          Decimal? @db.Decimal(12, 4)
  formato    String?
  tamanho    String?
  puxada     Decimal? @db.Decimal(14, 8)
  largura    Decimal? @db.Decimal(12, 4)
  rep        Decimal? @db.Decimal(12, 4)
  cil        String?
  col        String?
  cliente    String?
  notas      String?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tamanho])
  @@index([formato])
  @@index([maquina])
  @@index([numero])
  @@index([cliente])
}

model ParametroSistema {
  id        String  @id @default(cuid())
  empresaId String?
  chave     String  @unique
  valor     Json

  empresa Empresa? @relation(fields: [empresaId], references: [id], onDelete: SetNull)

  @@index([empresaId])
}

model Orcamento {
  id                 String          @id @default(cuid())
  numero             Int             @default(autoincrement())
  versao             Int             @default(1)
  status             OrcamentoStatus @default(RASCUNHO)
  data               DateTime        @default(now())
  empresaId          String?
  clienteParceiroId  String?
  vendedorParceiroId String?
  /// Snapshot imutável do nome na versão do orçamento.
  clienteNome        String
  vendedorNome       String
  observacoes        String?
  inputSnapshot      Json
  resultSnapshot     Json?
  /// Quando enviado para aprovação comercial (RASCUNHO → ENVIADO).
  enviadoEm          DateTime?
  /// Cliente abriu o link público.
  visualizadoEm      DateTime?
  /// Momento da decisão final (aprovação ou reprovação).
  decididoEm         DateTime?
  decididoPorId      String?
  /// Motivo obrigatório na reprovação; opcional na aprovação.
  motivoDecisao      String?
  /// Canal do aceite (LINK | MANUAL_GERENTE | INTERNO).
  canalAprovacao     CanalAprovacao?
  /// Nome informado pelo cliente no aceite pelo link.
  aceiteNomeCliente  String?
  /// Faixa escolhida pelo cliente (índice).
  aceiteFaixaIndex   Int?
  /// IP / UA do aceite (auditoria).
  aceiteIp           String?
  aceiteUserAgent    String?
  createdById        String
  parentId           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  empresa          Empresa?    @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  clienteParceiro  Parceiro?   @relation("OrcamentoCliente", fields: [clienteParceiroId], references: [id])
  vendedorParceiro Parceiro?   @relation("OrcamentoVendedor", fields: [vendedorParceiroId], references: [id])
  createdBy        User        @relation("CreatedBy", fields: [createdById], references: [id])
  decididoPor      User?       @relation("OrcamentoDecididoPor", fields: [decididoPorId], references: [id], onDelete: SetNull)
  parent           Orcamento?  @relation("Versions", fields: [parentId], references: [id])
  versions         Orcamento[] @relation("Versions")
  pedidoVenda      PedidoVenda?
  linkAprovacao    OrcamentoLinkAprovacao?

  @@index([empresaId])
  @@index([status])
  @@index([clienteNome])
  @@index([vendedorNome])
  @@index([clienteParceiroId])
  @@index([vendedorParceiroId])
  @@index([createdAt])
  @@index([decididoEm])
}

/// Link único de aprovação do cliente (APROVACAO_ORCAMENTO_CLIENTE.txt).
model OrcamentoLinkAprovacao {
  id            String    @id @default(cuid())
  orcamentoId   String    @unique
  token         String    @unique
  ativo         Boolean   @default(true)
  expiraEm      DateTime
  enviadoEm     DateTime?
  canalEnvio    String?
  destinoEnvio  String?
  visualizacoes Int       @default(0)
  usadoEm       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiraEm])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  field      String?
  oldValue   Json?
  newValue   Json?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Ciclo operacional (ver docs/CICLO_OPERACIONAL.md) ───────────────────────

enum TipoProduto {
  INSUMO
  ACABADO
  SERVICO
  INTERMEDIARIO
}

enum DocumentoSaidaPadrao {
  NFSE
  NFE
}

/// Ciclo do PED (GERACAO_PEDIDO.txt). CONFIRMADO = legado (= LIBERADO após MRP).
enum PedidoVendaStatus {
  RASCUNHO
  AGUARDA_CREDITO
  AGUARDA_ADIANTAMENTO
  LIBERADO
  /// Legado / sinônimo operacional pós-MRP (mantido p/ HML).
  CONFIRMADO
  EM_PRODUCAO
  PRODUZIDO
  FATURADO
  ENTREGUE
  LIQUIDADO
  CANCELADO
}

/// Flag de crédito do pedido (não substitui aceite do cliente).
enum CreditoPedidoFlag {
  OK
  BLOQUEADO
  AGUARDA_ADIANTAMENTO
  LIBERADO_MANUAL
}

/// Situação calculada do cliente no motor de crédito.
enum SituacaoCreditoCliente {
  NORMAL
  ATENCAO
  BLOQUEADO
  BLOQUEIO_MANUAL
}

enum NecessidadeItemTipo {
  PRODUCAO
  REVENDA
  SERVICO
}

enum OrdemProducaoStatus {
  PLANEJADA
  EMPENHADA
  EM_SETUP
  EM_PRODUCAO
  PAUSADA
  AGUARDA_INSUMO
  CONCLUIDA
  CANCELADA
}

enum TipoBaixaReceber {
  TOTAL
  PARCIAL
  JUROS
  DESCONTO
  ADIANTAMENTO
  PERDA
  CANCELAMENTO
}

enum CanalAprovacao {
  LINK
  MANUAL_GERENTE
  INTERNO
}

enum OrdemServicoStatus {
  PLANEJADA
  AGUARDANDO_MATERIAL
  LIBERADA
  EM_PRODUCAO
  CONCLUIDA
  CANCELADA
  RETRABALHO
}

enum NecessidadeLinhaStatus {
  OK
  PARCIAL
  FALTA
  SEM_PRODUTO
  ATENDIDA
}

enum PedidoCompraStatus {
  RASCUNHO
  ENVIADO
  PARCIAL
  RECEBIDO
  CANCELADO
}

enum NecessidadeCompraStatus {
  ABERTA
  EM_COMPRA
  ATENDIDA
  CANCELADA
}

enum DocEntradaStatus {
  RECEBIDO_XML
  VALIDANDO
  DIVERGENTE
  CONFERIDO
  ESTOQUE_LANCADO
  CANCELADO
}

enum DocEntradaItemStatus {
  PENDENTE_MATCH
  MATCHED
  DIVERGENTE
  IGNORADO
}

enum DocSaidaTipo {
  NFSE
  NFE
}

enum DocSaidaStatus {
  RASCUNHO
  ENVIADO
  AUTORIZADO
  ERRO
  CANCELADO
}

enum TituloReceberStatus {
  ABERTO
  PAGO
  VENCIDO
  CANCELADO
  PARCIAL
}

enum TituloPagarStatus {
  ABERTO
  PAGO
  VENCIDO
  CANCELADO
  PARCIAL
}

enum CobrancaInterStatus {
  PENDENTE
  EMITIDA
  PAGA
  CANCELADA
  ERRO
}

enum ContaBancariaTipo {
  CORRENTE
  POUPANCA
  PAGAMENTO
}

enum MovimentoBancarioTipo {
  CREDITO
  DEBITO
}

enum MovimentoBancarioOrigem {
  EXTRATO_INTER
  BAIXA_RECEBER
  BAIXA_PAGAR
  MANUAL
  AJUSTE
}

enum ConciliacaoStatus {
  PENDENTE
  CONCILIADO
  IGNORADO
}

enum EstoqueMovimentoTipo {
  ENTRADA_COMPRA
  RESERVA
  LIBERA_RESERVA
  BAIXA_PRODUCAO
  ENTRADA_PRODUCAO
  SAIDA_VENDA
  AJUSTE_INVENTARIO
  ESTORNO
  /// Sobra/retalho de bobina retorna ao estoque (TRATAMENTO_SOBRA_...).
  RETORNO_SOBRA
  /// Refugo/perda apontado na OP.
  REFUGO_PRODUCAO
}

enum EstoqueReservaStatus {
  ATIVA
  CONSUMIDA
  LIBERADA
}

enum IntegracaoProvider {
  FOCUS_NFE
  INTER
}

enum IntegracaoModo {
  SANDBOX
  PRODUCAO
  SIMULADO
}

/// Credenciais de integração (Focus / Inter) cifradas por empresa.
model EmpresaIntegracao {
  id              String             @id @default(cuid())
  empresaId       String
  provider        IntegracaoProvider
  modo            IntegracaoModo     @default(SIMULADO)
  /// Token / clientId / etc. em JSON cifrado (AES-GCM).
  credenciaisCifradas Bytes?
  baseUrlHomolog  String?
  baseUrlProd     String?
  webhookSecretCifrado Bytes?
  ativo           Boolean            @default(true)
  observacoes     String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, provider])
  @@index([empresaId, ativo])
}

/// Cadastro mestre de itens. `codigo` = chave de negócio numérica (única por empresa; imutável).
model Produto {
  id                    String               @id @default(cuid())
  empresaId             String
  /// Código interno ERP numérico (ex.: 0001). Obrigatório; sequencial por empresa.
  codigo                String
  sku                   String?
  descricao             String
  descricaoFiscal       String?
  tipo                  TipoProduto          @default(INSUMO)
  unidade               String               @default("UN")
  unidadeTributavel     String?
  fatorTributavel       Decimal?             @db.Decimal(14, 6)
  ncm                   String?
  cest                  String?
  ean                   String?
  origem                Int                  @default(0)
  cfopCompraPadrao      String?
  cfopVendaPadrao       String?
  /// Natureza de operação padrão (NF-e).
  naturezaOperacaoId    String?
  /// Simples Nacional — CSOSN (ex. 102).
  csosn                 String?
  /// Regime normal — CST ICMS (ex. 00).
  cstIcms               String?
  cstPis                String?
  cstCofins             String?
  /// NFS-e: código tributação nacional (ex. 130501).
  cTribNac              String?
  cNbs                  String?
  /// Tributação ISS NFS-e Nacional (1=Operação tributável, etc.).
  tributacaoIss         Int?
  issRetido             Boolean              @default(false)
  codigoMunicipioPrestacao String?
  /// Reforma tributária IBS/CBS (opcional).
  ibsCbsSituacaoTributaria      String?
  ibsCbsClassificacaoTributaria String?
  infAdProdPadrao       String?
  documentoSaidaPadrao  DocumentoSaidaPadrao @default(NFSE)
  controlaEstoque       Boolean              @default(true)
  estoqueMinimo         Decimal              @default(0) @db.Decimal(14, 4)
  estoqueMaximo         Decimal?             @db.Decimal(14, 4)
  permiteSaldoNegativo  Boolean              @default(false)
  custoMedio            Decimal              @default(0) @db.Decimal(14, 6)
  ultimoCusto           Decimal?             @db.Decimal(14, 6)
  papelId               String?
  acabamentoId          String?
  tubeteId              String?
  ativo                 Boolean              @default(true)
  observacoes           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  empresa      Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  naturezaOperacao NaturezaOperacao? @relation(fields: [naturezaOperacaoId], references: [id], onDelete: SetNull)
  papel        Papel?             @relation("ProdutoPapel", fields: [papelId], references: [id], onDelete: SetNull)
  acabamento   Acabamento?        @relation("ProdutoAcabamento", fields: [acabamentoId], references: [id], onDelete: SetNull)
  tubete       Tubete?            @relation("ProdutoTubete", fields: [tubeteId], references: [id], onDelete: SetNull)
  fornecedores ProdutoFornecedor[]
  saldos       EstoqueSaldo[]
  movimentos   EstoqueMovimento[]
  reservas     EstoqueReserva[]
  pedidoItens  PedidoItem[]
  necessidades OsNecessidade[]
  compraItens  PedidoCompraItem[]
  docEntradaItens DocEntradaItem[]
  necessidadeCompras NecessidadeCompra[]

  @@unique([empresaId, codigo])
  @@index([empresaId, tipo])
  @@index([empresaId, ativo])
  @@index([ncm])
  @@index([naturezaOperacaoId])
  @@index([papelId])
  @@index([acabamentoId])
  @@index([tubeteId])
}

/// Natureza de operação fiscal (texto da NF-e + CFOPs por destino).
model NaturezaOperacao {
  id                 String   @id @default(cuid())
  empresaId          String
  codigo             String
  descricao          String
  cfopDentroUf       String
  cfopForaUf         String
  /// finalidade_emissao Focus (1=Normal, 2=Complementar, 3=Ajuste, 4=Devolução).
  finalidadeEmissao  Int      @default(1)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produtos Produto[]
  parametrosMercadoria ParametroFiscalEmpresa[] @relation("ParamFiscalNaturezaMercadoria")

  @@unique([empresaId, codigo])
  @@index([empresaId, ativo])
}

/// Controle de série e numeração (NF-e / DPS NFS-e Nacional).
model SerieDocumentoFiscal {
  id            String             @id @default(cuid())
  empresaId     String
  tipo          SerieDocumentoTipo
  serie         Int
  proximoNumero Int                @default(1)
  ambiente      AmbienteFiscal     @default(HOMOLOGACAO)
  ativo         Boolean            @default(true)
  observacoes   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, tipo, serie, ambiente])
  @@index([empresaId, tipo, ativo])
}

/// Parâmetros fiscais da emitente (Simples Nacional, transparência, defaults).
model ParametroFiscalEmpresa {
  id                     String   @id @default(cuid())
  empresaId              String   @unique
  /// codigo_opcao_simples_nacional (1–3).
  opSimpNac              Int      @default(3)
  /// regime_apuracao_tributos_sn.
  regApTribSN            Int      @default(1)
  /// regime_especial_tributacao.
  regEspTrib             Int      @default(0)
  /// percentual_total_tributos_simples_nacional (Lei transparência).
  pTotTribSN             Decimal  @default(11.81) @db.Decimal(6, 2)
  pTotTribFederal        Decimal? @db.Decimal(6, 2)
  pTotTribEstadual       Decimal? @db.Decimal(6, 2)
  pTotTribMunicipal      Decimal? @db.Decimal(6, 2)
  csosnPadrao            String   @default("102")
  cstPisPadrao           String   @default("49")
  cstCofinsPadrao        String   @default("49")
  serieDpsPadrao         Int      @default(70000)
  serieNfePadrao         Int      @default(1)
  naturezaMercadoriaId   String?
  /// modalidade_frete padrão (9=Sem frete).
  modalidadeFretePadrao  Int      @default(9)
  /// presenca_comprador padrão (1=Operação presencial).
  presencaCompradorPadrao Int     @default(1)
  infCplPadrao           String?
  textoCreditoSn         String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  empresa            Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  naturezaMercadoria NaturezaOperacao? @relation("ParamFiscalNaturezaMercadoria", fields: [naturezaMercadoriaId], references: [id], onDelete: SetNull)
}

model ProdutoFornecedor {
