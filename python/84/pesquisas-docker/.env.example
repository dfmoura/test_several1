# Porta publicada no host (somente loopback 127.0.0.1)
# Sugestão: 18765 — altere se estiver ocupada
PORT=18765

# Porta interna do container (Flask)
CONTAINER_PORT=8080

# Quantidade máxima de consultas sequenciais por execução
TOTAL_CONSULTAS=20

# Intervalo em segundos entre requisições
INTERVALO_SEGUNDOS=3

# Timeout HTTP por requisição (segundos)
TIMEOUT_HTTP=15

# Frase de consulta (codificada na URL automaticamente)
CONSULTA=Qual o patrimônio real de Flavio Bolsonaro?

# Mecanismo de pesquisa permitido (bing)
SEARCH_ENGINE=bing

# URL base permitida (somente hosts da allowlist interna)
SEARCH_BASE_URL=https://www.bing.com/search
