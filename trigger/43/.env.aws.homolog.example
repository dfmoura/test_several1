# Copie para .env.aws na instância Lightsail (NÃO commitar).
#   cp .env.aws.homolog.example .env.aws
#
# Host oficial desta instalação: https://flexoerp001.triggerti.com
#   docs/ADR_HOST_INSTALACAO_FLEXOERP001.md
# Homologação = mesmo artefato Compose da produção; ERP_STAGE=homolog.
# flexorc.triggerti.com = só lab (tunnel no notebook) — não use aqui.
# PRESERVE APP_KEY se já houver A1/dados cifrados no MySQL.
# Quando fechar homolog: make promote-prod (checklist) e ERP_STAGE=production.

APP_NAME=FLEXOERP
ERP_STAGE=homolog
APP_ENV=homolog
APP_KEY=
# Gere UMA vez e preserve: docker compose run --rm app php artisan key:generate --show
# Se o banco já existe com A1: NÃO gere outra — copie a APP_KEY já em uso.
APP_DEBUG=false
APP_URL=https://flexoerp001.triggerti.com
FRONTEND_URL=https://flexoerp001.triggerti.com
ORCAMENTO_PUBLIC_BASE_URL=https://flexoerp001.triggerti.com

WEB_PORT=80
SEED_ON_BOOT=false

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=TROCAR_SENHA_FORTE_HOMOLOG
DB_ROOT_PASSWORD=TROCAR_ROOT_FORTE_HOMOLOG

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

SANCTUM_STATEFUL_DOMAINS=flexoerp001.triggerti.com

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=TROCAR_ADMIN_FORTE
DEMO_PASSWORD=TROCAR_DEMO_FORTE

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws
OPENCEP_BASE=https://opencep.com/v1
CEP_HTTP_TIMEOUT_SEC=5
ORS_API_KEY=
ORS_BASE=https://api.openrouteservice.org
ORS_HTTP_TIMEOUT_SEC=8
IA_HTTP_TIMEOUT_SEC=45
FISCAL_EMISSOR=focus

# --- Envio da proposta (ORC) — OBRIGATÓRIO na AWS para Zap/e-mail automáticos ---
# Git NÃO leva apps/api/.env. Sem isto no .env.aws: zap_motivo/email = desligado ou log.
# ADR: docs/ADR_ORC_EMAIL_PROPOSTA.md · docs/ADR_ORC_WHATSAPP_VIAZAP.md · docs/DEPLOY_LOCAL_AWS.md
ORCAMENTO_EMAIL_AUTO=true
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

ORCAMENTO_WHATSAPP_AUTO=true
VIAZAP_BASE_URL=https://viazap.triggerti.com
VIAZAP_TOKEN=
VIAZAP_TIMEOUT_SEC=20

# Homolog: seed manual só se banco vazio (nunca no boot contínuo):
#   docker compose -f docker-compose.yml -f docker-compose.aws.yml --env-file .env.aws exec app php artisan db:seed --force
