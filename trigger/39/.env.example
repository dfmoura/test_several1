APP_NAME=ERP-RLP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8039
FRONTEND_URL=http://localhost:8039

WEB_PORT=8039
DB_PORT=33069
VITE_PORT=5173
PHP_TARGET=dev
SEED_ON_BOOT=true

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT_INTERNAL=3306
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=erp_secret
DB_ROOT_PASSWORD=root_secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis

SANCTUM_STATEFUL_DOMAINS=localhost:8039,127.0.0.1:8039,localhost:5173

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws

# Timeout HTTP ao testar/consumir provedores de IA (segundos)
IA_HTTP_TIMEOUT_SEC=45

# Lightsail / prod tips:
# - Use instance 1 GB RAM mínimo (free trial / $5 plan)
# - Não exponha 3306; só 80/443
# - APP_DEBUG=false; gere APP_KEY estável; secrets fora do git
