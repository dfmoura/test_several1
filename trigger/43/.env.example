APP_NAME=FLEXOERP
# Estágio do caminho canônico: local | homolog | production
ERP_STAGE=local
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8043
FRONTEND_URL=http://localhost:8043

# Link público de aprovação do ORC (Ctrl+C) + retorno/webhook ASAAS no ensaio.
# Prod (Lightsail): https://flexoerp001.triggerti.com — docs/ADR_HOST_INSTALACAO_FLEXOERP001.md
# Lab/ensaio (tunnel notebook): https://flexorc.triggerti.com — make ensaio-asaas-ativar
# Local puro (sem webhook): http://localhost:8043
ORCAMENTO_PUBLIC_BASE_URL=http://localhost:8043

# E-mail da proposta ao enviar link (ADR_ORC_EMAIL_PROPOSTA). Motor = instalação; Reply-To = empresas.email.
# Local: pode ficar em apps/api/.env (Compose vazio não sobrescreve). AWS: preencha em .env.aws.
ORCAMENTO_EMAIL_AUTO=true
MAIL_MAILER=log
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp da proposta via ViaZap (ADR_ORC_WHATSAPP_VIAZAP). Produção: https://viazap.triggerti.com
# AWS: VIAZAP_* no .env.aws (git não leva token).
ORCAMENTO_WHATSAPP_AUTO=true
VIAZAP_BASE_URL=
VIAZAP_TOKEN=
VIAZAP_TIMEOUT_SEC=10

# Fatia comercial desta instalação: ORC até enviar link (sem sinal PIX / menu financeiro).
FLEXORC_ATE_ENVIO_LINK=false
FLEXORC_PUBLIC_CONTA_REGISTRATION=false

# Compose local: SEMPRE base + overlay de portas. Sem isto, `docker compose up`
# sobe containers sem :8043/:8000 no host → ERR_CONNECTION_REFUSED no browser.
# AWS: use `make up-aws` ( -f explícitos; não copie esta linha para .env.aws ).
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

WEB_PORT=8043
API_PORT=8040
DB_PORT=33073
VITE_PORT=5173
SEED_ON_BOOT=true

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=erp_secret
DB_ROOT_PASSWORD=root_secret

# Compose injeta database (alinhado ao monólito Lightsail — sem Redis no dia 1)
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Sessão de acesso (Sanctum): 1 por usuário, teto 6 simultâneos, idle 30 min
AUTH_IDLE_MINUTES=30
AUTH_MAX_USUARIOS_SIMULTANEOS=6

SANCTUM_STATEFUL_DOMAINS=localhost:8043,127.0.0.1:8043,localhost:5173,127.0.0.1:5173

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws
OPENCEP_BASE=https://opencep.com/v1
CEP_HTTP_TIMEOUT_SEC=5

# OpenRouteService (km de carro EMP→PAR). Chave em https://openrouteservice.org/dev/#/signup
# Vazio = posição do CEP funciona; km fica "—" até configurar.
ORS_API_KEY=
ORS_BASE=https://api.openrouteservice.org
ORS_HTTP_TIMEOUT_SEC=8

IA_HTTP_TIMEOUT_SEC=45

# Emissão NF sem A1 (só local). homolog/production ignoram — sempre Focus.
# stub = completa o fluxo com chave sintética (sem valor fiscal).
# Quando o hub Focus estiver apto, o Focus ganha e o stub some.
# ASAAS — conta FLEXORC (Checkout cartão recorrente) e, se BANK_PROVIDER=asaas, PIX do sinal.
# Vazio = mock (local/CI). PCI fica no provedor; o ERP não guarda cartão.
# Ensaio ≈ produção: make ensaio-asaas-ativar + webhook no painel (sandbox).
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=
# Token do mecanismo "Validação de saque via Webhook" (vazio = usa ASAAS_WEBHOOK_TOKEN).
ASAAS_SAQUE_WEBHOOK_TOKEN=
BANK_PROVIDER=mock
# BILLING_PROVIDER=mock
# BILLING_PROVIDER=asaas
# BILLING_PROVIDER=inter
# FLEXORC_INTER_PIX_TTL_HORAS=3
# Inter mensalidade: credenciais no console /plataforma/integracoes/inter
# Webhook: {APP_URL}/api/v1/webhooks/bancarios/inter
# FLEXORC_BILLING_VALUE=0.00
# FLEXORC_BILLING_ANTECIPADA=true
# FLEXORC_ALERTA_CORTESIA_DIAS=7


# --- Caminho local → AWS ---
# make up          → docker-compose.yml + docker-compose.local.yml
# make up-aws      → docker-compose.yml + docker-compose.aws.yml  (use .env.aws)
# make aws-check   → valida .env.aws antes de subir
# make promote-prod → checklist da virada homolog → production
# docs/DEPLOY_LOCAL_AWS.md
#
# Lightsail alvo: Ubuntu · 2 GB · 2 vCPU · 60 GB · 3 TB
# Host: sudo bash scripts/lightsail-setup-swap.sh
# Só 80/443 públicos; MySQL sem publish (overlay aws)
