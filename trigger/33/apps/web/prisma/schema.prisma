model TituloReceber {
  id            String              @id @default(cuid())
  empresaId     String
  /// Multi-título por pedido (parcelas / sinal + saldo). Null = legado avulso.
  pedidoVendaId String?
  /// Sequencial de exibição TIT-AAAA-NNNNN.
  numero        Int                 @default(autoincrement())
  /// Parcela (1..N); 0 = adiantamento/sinal.
  parcela       Int                 @default(1)
  /// Indica título de sinal (libera produção ao baixar).
  isAdiantamento Boolean            @default(false)
  clienteParceiroId String?
  valor         Decimal             @db.Decimal(14, 2)
  /// Valor já liquidado (suporta baixa parcial).
  valorPago     Decimal             @default(0) @db.Decimal(14, 2)
  juros         Decimal             @default(0) @db.Decimal(14, 2)
  desconto      Decimal             @default(0) @db.Decimal(14, 2)
  vencimento    DateTime
  status        TituloReceberStatus @default(ABERTO)
  pagoEm        DateTime?
  /// Observação operacional (renegociação, desconto, etc.).
  observacao    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  empresa         Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedidoVenda     PedidoVenda?      @relation(fields: [pedidoVendaId], references: [id], onDelete: Cascade)
  clienteParceiro Parceiro?         @relation("TituloAdiantamentoCliente", fields: [clienteParceiroId], references: [id], onDelete: SetNull)
  cobranca        CobrancaInter?
  baixas          BaixaReceber[]
  movimentos      MovimentoBancario[]
  conciliacoes    ConciliacaoBancaria[]

  @@index([empresaId, status])
  @@index([vencimento])
  @@index([empresaId, vencimento])
  @@index([pedidoVendaId])
  @@index([numero])
}

/// Documento de baixa / recebimento BX-AAAA-NNNNN (RECEBIMENTO_BAIXA_COBRANCA.txt).
model BaixaReceber {
  id              String           @id @default(cuid())
  empresaId       String
  numero          Int              @default(autoincrement())
  tituloReceberId String
  tipo            TipoBaixaReceber @default(TOTAL)
  valor           Decimal          @db.Decimal(14, 2)
  juros           Decimal          @default(0) @db.Decimal(14, 2)
  desconto        Decimal          @default(0) @db.Decimal(14, 2)
  dataCredito     DateTime         @default(now())
  contaBancariaId String?
  forma           String?
  via             String?
  observacao      String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  titulo TituloReceber @relation(fields: [tituloReceberId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([tituloReceberId])
  @@index([dataCredito])
  @@index([numero])
}

model CobrancaInter {
  id                String             @id @default(cuid())
  tituloReceberId   String             @unique
  codigoSolicitacao String?
  nossoNumero       String?
  linhaDigitavel    String?
  pixCopiaECola     String?
  pdfUrl            String?
  status            CobrancaInterStatus @default(PENDENTE)
  simulado          Boolean            @default(false)
  mensagemErro      String?
  pagoEm            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  titulo TituloReceber @relation(fields: [tituloReceberId], references: [id], onDelete: Cascade)

  @@index([codigoSolicitacao])
  @@index([status])
}

/// Conta bancária operacional (Inter PJ por padrão) — base para saldo/extrato/conciliação.
model ContaBancaria {
  id                 String            @id @default(cuid())
  empresaId          String
  bancoCodigo        String            @default("077")
  bancoNome          String            @default("Banco Inter")
  agencia            String?
  conta              String?
  tipo               ContaBancariaTipo @default(CORRENTE)
  apelido            String            @default("Conta Inter PJ")
  principal          Boolean           @default(true)
  ativa              Boolean           @default(true)
  /// Snapshot do último saldo consultado (API Saldo Inter).
  saldoDisponivel    Decimal?          @db.Decimal(14, 2)
  saldoBloqueado     Decimal?          @db.Decimal(14, 2)
  saldoConsultadoEm  DateTime?
  simulado           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  empresa    Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimentos MovimentoBancario[]

  @@index([empresaId, ativa])
  @@index([empresaId, principal])
}

/// Contas a pagar — gerado na entrada de NF de compra (ciclo compras → financeiro).
model TituloPagar {
  id                 String           @id @default(cuid())
  empresaId          String
  pedidoCompraId     String?
  documentoEntradaId String?          @unique
  fornecedorId       String?
  fornecedorNome     String
  fornecedorDoc      String?
  descricao          String
  valor              Decimal          @db.Decimal(14, 2)
  valorPago          Decimal          @default(0) @db.Decimal(14, 2)
  vencimento         DateTime
  status             TituloPagarStatus @default(ABERTO)
  pagoEm             DateTime?
  observacao         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  empresa          Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  pedidoCompra     PedidoCompra?           @relation(fields: [pedidoCompraId], references: [id], onDelete: SetNull)
  documentoEntrada DocumentoFiscalEntrada? @relation(fields: [documentoEntradaId], references: [id], onDelete: SetNull)
  movimentos       MovimentoBancario[]
  conciliacoes     ConciliacaoBancaria[]

  @@index([empresaId, status])
  @@index([vencimento])
  @@index([empresaId, vencimento])
  @@index([pedidoCompraId])
  @@index([fornecedorId])
}

/// Lançamento do extrato bancário (Inter Extrato) ou baixa manual.
model MovimentoBancario {
  id              String                  @id @default(cuid())
  empresaId       String
  contaBancariaId String
  dataEntrada     DateTime
  tipoOperacao    MovimentoBancarioTipo
  tipoTransacao   String
  valor           Decimal                 @db.Decimal(14, 2)
  titulo          String
  descricao       String
  /// Idempotência com o extrato Inter (hash estável dos campos-chave).
  hashExterno     String?
  origem          MovimentoBancarioOrigem @default(EXTRATO_INTER)
  simulado        Boolean                 @default(false)
  detalhesJson    Json?
  tituloReceberId String?
  tituloPagarId   String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  empresa       Empresa              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  conta         ContaBancaria        @relation(fields: [contaBancariaId], references: [id], onDelete: Cascade)
  tituloReceber TituloReceber?       @relation(fields: [tituloReceberId], references: [id], onDelete: SetNull)
  tituloPagar   TituloPagar?         @relation(fields: [tituloPagarId], references: [id], onDelete: SetNull)
  conciliacao   ConciliacaoBancaria?

  @@unique([contaBancariaId, hashExterno])
  @@index([empresaId, dataEntrada])
  @@index([contaBancariaId, dataEntrada])
  @@index([tituloReceberId])
  @@index([tituloPagarId])
}

/// Matching extrato ↔ título (AR/AP) — conciliação bancária ERP.
model ConciliacaoBancaria {
  id                  String            @id @default(cuid())
  movimentoBancarioId String            @unique
  tituloReceberId     String?
  tituloPagarId       String?
  status              ConciliacaoStatus @default(PENDENTE)
  matchedAt           DateTime?
  matchedById         String?
  observacao          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  movimento     MovimentoBancario @relation(fields: [movimentoBancarioId], references: [id], onDelete: Cascade)
  tituloReceber TituloReceber?    @relation(fields: [tituloReceberId], references: [id], onDelete: SetNull)
  tituloPagar   TituloPagar?      @relation(fields: [tituloPagarId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([tituloReceberId])
  @@index([tituloPagarId])
}

model EntregaPedido {
  id            String    @id @default(cuid())
  pedidoVendaId String    @unique
  numero        Int       @default(autoincrement())
  dataEntrega   DateTime  @default(now())
  volumes       Int?
  rolos         Int?
  caixas        Int?
  transportadora String?
  modalidade    String?   @default("CLIENTE_RETIRA")
  comprovanteUrl String?
  /// Confirmação do cliente (ENTREGA_CONFIRMACAO_CLIENTE).
  confirmadoClienteEm DateTime?
  confirmadoPorNome   String?
  canhotoUrl          String?
  observacoes   String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pedidoVenda PedidoVenda @relation(fields: [pedidoVendaId], references: [id], onDelete: Cascade)
}
