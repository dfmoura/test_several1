APP_NAME=ERP-RLP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8039
FRONTEND_URL=http://localhost:8039

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=erp_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost:8039,127.0.0.1:8039,localhost:5173,127.0.0.1:5173

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws
SEED_ON_BOOT=true

# Timeout HTTP ao testar/consumir provedores de IA (segundos)
IA_HTTP_TIMEOUT_SEC=45

# Relatórios IA (Fases 0–2) — rollback = desligar flag
RELATORIO_IA_AUTOCORRECAO=true
RELATORIO_IA_JSON_MODE=true
RELATORIO_IA_LOG_PROMPT=false
RELATORIO_IA_PLANEJAR_ENDPOINT=true
RELATORIO_IA_PLANEJAR_CACHE_SEC=600
# Guard-rail DomPDF (células = linhas × colunas)
RELATORIO_CELULAS_MAX=8000
# Retenção: 0 = desliga. Manter LOG_PROMPT=false em produção.
RELATORIO_PDF_RETENCAO_DIAS=180
RELATORIO_EXECUCAO_RETENCAO_DIAS=90
RELATORIO_IA_NARRATIVA_TIMEOUT_SEC=20
