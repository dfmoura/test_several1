# =============================================================================
# NF-e MG — ambiente de desenvolvimento
# Portas 19xxx para não colidir com o NFS-e Nacional (18xxx).
# =============================================================================

NFE_AMBIENTE=dev
NFE_SEFAZ_MOCK=true
NFE_CERT_REQUIRED=false
NFE_UF=MG
NFE_CUF=31

# Criptografia de PFX em repouso (32 bytes hex). Trocar em produção.
NFE_CERT_KEK=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

NFE_API_KEY=dev-api-key-change-in-production
NFE_JWT_SECRET=dev-jwt-secret-change-in-production
NFE_WEB_PASSWORD=admin
NFE_WEB_SESSION_SECRET=dev-session-secret-nfe-mg

LOG_LEVEL=info

# Portas no host
NFE_HOST_PORT_API=19100
NFE_HOST_PORT_DANFE=19101
NFE_HOST_PORT_WEB=19102
NFE_HOST_PORT_TRAEFIK=19180
NFE_HOST_PORT_TRAEFIK_DASHBOARD=19181
NFE_HOST_PORT_POSTGRES=16432
NFE_HOST_PORT_REDIS=17379
NFE_HOST_PORT_RABBITMQ_UI=19672
NFE_HOST_PORT_MINIO_CONSOLE=19111
NFE_HOST_PORT_PROMETHEUS=19190
NFE_HOST_PORT_GRAFANA=19200

MINIO_ACCESS_KEY=nfe
MINIO_SECRET_KEY=nfe-secret-key
