APP_NAME=FLEXOERP
ERP_STAGE=local
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8043
FRONTEND_URL=http://localhost:8043

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=erp_secret

# Sessão de acesso (uma por usuário, teto 6, idle 30 min)
AUTH_IDLE_MINUTES=30
AUTH_MAX_USUARIOS_SIMULTANEOS=6
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost:8043,127.0.0.1:8043,localhost:5173,127.0.0.1:5173

# Link público ORC + retorno/webhook no ensaio. Tunnel: https://flexorc.triggerti.com
# make ensaio-asaas-ativar · docs/ADR_ENSAIO_ASAAS_FLEXORC.md
ORCAMENTO_PUBLIC_BASE_URL=http://localhost:8043

# E-mail da proposta ao enviar link (ADR_ORC_EMAIL_PROPOSTA). Motor = instalação; Reply-To = empresas.email.
ORCAMENTO_EMAIL_AUTO=true
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp da proposta via ViaZap (ADR_ORC_WHATSAPP_VIAZAP). Tunnel: https://viazap.triggerti.com
ORCAMENTO_WHATSAPP_AUTO=true
VIAZAP_BASE_URL=
VIAZAP_TOKEN=
VIAZAP_TIMEOUT_SEC=10

# Fatia comercial: ORC até enviar link (sem sinal / financeiro na UX).
FLEXORC_ATE_ENVIO_LINK=false
# Alta pública de conta no login (false = só admin master / CLI plataforma:criar-conta).
FLEXORC_PUBLIC_CONTA_REGISTRATION=false

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws
OPENCEP_BASE=https://opencep.com/v1
CEP_HTTP_TIMEOUT_SEC=5
SEED_ON_BOOT=true

# OpenRouteService (km de carro EMP→PAR). Chave em https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
ORS_BASE=https://api.openrouteservice.org
ORS_HTTP_TIMEOUT_SEC=8

IA_HTTP_TIMEOUT_SEC=45

# Autorização de teste sem A1 (só ERP_STAGE=local). Homolog/prod ignoram.
FISCAL_EMISSOR=stub

# Mensalidade da conta FLEXORC (EMP → TRIGGER). Distinta do PIX do sinal.
FLEXORC_BILLING_VALUE=297.00
FLEXORC_BILLING_CYCLE=MONTHLY
FLEXORC_BILLING_DESCRICAO="Mensalidade da conta FLEXORC"
BILLING_PROVIDER=
# mock | asaas (cartão) | inter (PIX BolePix — setup em /plataforma/integracoes/inter)
# FLEXORC_INTER_PIX_TTL_HORAS=3
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Mesmo valor no header asaas-access-token do webhook no painel ASAAS (sandbox).
ASAAS_WEBHOOK_TOKEN=
# Token do mecanismo "Validação de saque via Webhook" (vazio = usa ASAAS_WEBHOOK_TOKEN).
ASAAS_SAQUE_WEBHOOK_TOKEN=
BANK_PROVIDER=mock
FLEXORC_BILLING_ANTECIPADA=true
FLEXORC_ALERTA_CORTESIA_DIAS=7


# AWS: use ../../.env.aws.* examples + docs/DEPLOY_LOCAL_AWS.md
