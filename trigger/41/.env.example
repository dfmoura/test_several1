APP_NAME=zap-outbound-gateway
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Host publishes (documentação / compose)
API_HOST_PORT=8141
EVOLUTION_HOST_PORT=8142
ADMIN_UI_HOST_PORT=8143
POSTGRES_HOST_PORT=5437
REDIS_HOST_PORT=6381
RABBITMQ_AMQP_HOST_PORT=5671
RABBITMQ_MGMT_HOST_PORT=15641

ADMIN_TOKEN=change-me-admin-token-strong
WEBHOOK_SECRET=change-me-webhook-secret

DATABASE_URL=postgresql+asyncpg://zap:zap@postgres:5432/zap_gateway
DATABASE_URL_SYNC=postgresql://zap:zap@postgres:5432/zap_gateway
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://zap:zap@rabbitmq:5672/zap

EVOLUTION_URL=http://evolution:8080
EVOLUTION_KEY=change-me-evolution-key-strong

# Política de envio
DEFAULT_RATE_LIMIT_PER_MINUTE=20
MAX_SEND_ATTEMPTS=5
MESSAGE_RETENTION_DAYS=90
WORKER_PREFETCH=3
