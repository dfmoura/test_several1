# Virada homolog → produção (chave final).
#   1. Snapshot Lightsail + dump MySQL
#   2. cp .env.aws.production.example .env.aws   (ou edite o .env.aws atual)
#   3. make aws-check && make up-aws
#   4. Confirme GET /api/v1/health → "stage":"production"
#
# NÃO commitar .env.aws

APP_NAME=FLEXOERP
ERP_STAGE=production
APP_ENV=production
APP_KEY=
# OBRIGATÓRIO: mesma APP_KEY da homolog se mantiver dados cifrados (IA/Focus tokens).
# Se for banco NOVO, gere chave nova e não reutilize tokens cifrados antigos.
APP_DEBUG=false
APP_URL=https://erp.seudominio.com.br
FRONTEND_URL=https://erp.seudominio.com.br
ORCAMENTO_PUBLIC_BASE_URL=https://flexorc.triggerti.com

WEB_PORT=80
SEED_ON_BOOT=false

DB_CONNECTION=mysql
DB_HOST=mysql
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=TROCAR_SENHA_FORTE_PRODUCAO
DB_ROOT_PASSWORD=TROCAR_ROOT_FORTE_PRODUCAO

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

SANCTUM_STATEFUL_DOMAINS=erp.seudominio.com.br,flexorc.triggerti.com

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=TROCAR_ADMIN_FORTE_PRODUCAO
# Em produção: desative usuários demo ou troque senhas após 1º acesso
DEMO_PASSWORD=TROCAR_OU_DESATIVE_DEMOS

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws
IA_HTTP_TIMEOUT_SEC=45
