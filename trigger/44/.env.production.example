# Instância privada na AWS (Lightsail / EC2). NÃO use como .env local.
# Gerar com: ./scripts/new-prod-env.sh zap.seudominio.com voce@seudominio.com

APP_NAME=zapvia
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://zap.seudominio.com

DOMAIN=zap.seudominio.com
ACME_EMAIL=voce@seudominio.com

JWT_SECRET=gere-com-o-script
APP_ENCRYPTION_KEY=gere-com-o-script
ADMIN_TOKEN=gere-com-o-script
WEBHOOK_SECRET=gere-com-o-script

DEPLOYMENT_MODE=private
REGISTRATION_MODE=bootstrap
BILLING_AUTO_ACTIVATE=true
BILLING_PROVIDER=sandbox
PLAN_CODE=zapvia_pro
PLAN_NAME=ZapVia Pro
PLAN_PRICE_CENTS=9700
PLAN_CURRENCY=BRL
PLAN_INTERVAL_DAYS=3650

WHATSAPP_PROVIDER=sandbox
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

EVOLUTION_URL=http://evolution:8080
EVOLUTION_KEY=gere-com-o-script
EVOLUTION_ENABLED=true

POSTGRES_PASSWORD=gere-com-o-script
RABBITMQ_PASSWORD=gere-com-o-script

DATABASE_URL=postgresql+asyncpg://zapvia:gere-com-o-script@postgres:5432/zapvia
DATABASE_URL_SYNC=postgresql://zapvia:gere-com-o-script@postgres:5432/zapvia
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://zapvia:gere-com-o-script@rabbitmq:5672/zapvia

DEFAULT_RATE_LIMIT_PER_MINUTE=30
MAX_SEND_ATTEMPTS=5
MESSAGE_RETENTION_DAYS=90
WORKER_PREFETCH=3
JWT_TTL_HOURS=168
