generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDEDOR
  ORCAMENTISTA
}

enum OrcamentoStatus {
  RASCUNHO
  ENVIADO
  APROVADO
  PERDIDO
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(VENDEDOR)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orcamentos   Orcamento[] @relation("CreatedBy")
  auditLogs    AuditLog[]
}

model Cliente {
  id        String   @id @default(cuid())
  nome      String
  documento String?
  email     String?
  telefone  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orcamentos Orcamento[]

  @@index([nome])
}

model Papel {
  id        String   @id @default(cuid())
  nome      String   @unique
  precoM2   Decimal  @db.Decimal(12, 4)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Acabamento {
  id        String   @id @default(cuid())
  nome      String   @unique
  precoM2   Decimal  @db.Decimal(12, 4)
  perdaM2   Decimal  @default(0) @db.Decimal(12, 4)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tubete {
  id        String   @id @default(cuid())
  tamanho   String   @unique
  nome      String?
  preco     Decimal  @db.Decimal(12, 4)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HoraParada {
  id      String  @id @default(cuid())
  tipo    String  @unique
  tempoH  Decimal @db.Decimal(12, 6)
  tempoMin Int?
  ativo   Boolean @default(true)
}

model Maquina {
  id     String  @id @default(cuid())
  nome   String  @unique
  grupo  String
  ativo  Boolean @default(true)
}

model HoraMaquinaTarifa {
  id     String  @id @default(cuid())
  grupo  String
  cores  String
  tarifa Decimal @db.Decimal(12, 4)

  @@unique([grupo, cores])
}

model PerdaPapel {
  id      String  @id @default(cuid())
  cores   String  @unique
  m2Fixo  Decimal? @db.Decimal(12, 4)
  fator   Decimal? @db.Decimal(12, 4)
}

model CaixaLookup {
  id         String @id @default(cuid())
  chave      String @unique
  qtdeCaixas Int
}

model Faca {
  id         String   @id @default(cuid())
  maquina    String?
  conjugada  String?
  fornecedor String?
  numero     String?
  z          Decimal? @db.Decimal(12, 4)
  formato    String?
  tamanho    String?
  puxada     Decimal? @db.Decimal(14, 8)
  largura    Decimal? @db.Decimal(12, 4)
  rep        Decimal? @db.Decimal(12, 4)
  cil        String?
  col        String?
  cliente    String?
  notas      String?
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tamanho])
  @@index([formato])
  @@index([maquina])
  @@index([numero])
  @@index([cliente])
}

model ParametroSistema {
  id    String @id @default(cuid())
  chave String @unique
  valor Json
}

model Orcamento {
  id              String          @id @default(cuid())
  numero          Int             @default(autoincrement())
  versao          Int             @default(1)
  status          OrcamentoStatus @default(RASCUNHO)
  data            DateTime        @default(now())
  clienteId       String?
  clienteNome     String
  vendedorNome    String
  observacoes     String?
  inputSnapshot   Json
  resultSnapshot  Json?
  createdById     String
  parentId        String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  cliente   Cliente?   @relation(fields: [clienteId], references: [id])
  createdBy User       @relation("CreatedBy", fields: [createdById], references: [id])
  parent    Orcamento? @relation("Versions", fields: [parentId], references: [id])
  versions  Orcamento[] @relation("Versions")

  @@index([status])
  @@index([clienteNome])
  @@index([vendedorNome])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  field      String?
  oldValue   Json?
  newValue   Json?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
