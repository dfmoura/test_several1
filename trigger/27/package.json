{
  "name": "orcamento-flexo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test -w @orcamento/pricing-engine",
    "dev": "npm run dev -w web",
    "build": "npm run build -w @orcamento/pricing-engine && npm run build -w web",
    "db:migrate": "npm run db:migrate -w web",
    "db:seed": "npm run db:seed -w web"
  },
  "engines": {
    "node": ">=20"
  }
}
