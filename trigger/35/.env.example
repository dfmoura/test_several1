# Copie para .env na raiz (compose) — NUNCA commitar segredos reais

POSTGRES_USER=erp_rlp
POSTGRES_PASSWORD=erp_rlp_dev_change_me
POSTGRES_DB=erp_rlp
POSTGRES_PORT=55432

DATABASE_URL=postgresql://erp_rlp:erp_rlp_dev_change_me@postgres:5432/erp_rlp?schema=public

JWT_SECRET=dev-only-change-me-use-long-random-string
JWT_EXPIRES_IN=8h

API_PORT=3035
WEB_PORT=5175
CORS_ORIGIN=http://localhost:5175

# MinIO (S3 local DEV) — host ports 9100/9101 (9000 costuma estar ocupada)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_BUCKET=erp-rlp
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9100
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_BUCKET=erp-rlp
S3_REGION=us-east-1

# --- M09 adapters ---
