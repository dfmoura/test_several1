{
  "name": "erp-rlp",
  "private": true,
  "version": "0.1.0",
  "description": "ERP RLP — monólito modular (Fase 0 plataforma + Fase 1 Must)",
  "scripts": {
    "dev:api": "pnpm --filter @erp-rlp/api dev",
    "dev:web": "pnpm --filter @erp-rlp/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @erp-rlp/api prisma:migrate",
    "db:seed": "pnpm --filter @erp-rlp/api prisma:seed",
    "db:studio": "pnpm --filter @erp-rlp/api prisma:studio"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.9.0"
}
