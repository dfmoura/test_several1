APP_NAME=FLEXOERP
ERP_STAGE=local
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8039
FRONTEND_URL=http://localhost:8039

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=erp_rlp
DB_USERNAME=erp
DB_PASSWORD=erp_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost:8039,127.0.0.1:8039,localhost:5173,127.0.0.1:5173

# Link público ORC. Em teste com Tunnel: https://flexorc.triggerti.com
ORCAMENTO_PUBLIC_BASE_URL=http://localhost:8039

DEFAULT_EMPRESA_CODIGO=EMP-00001
ADMIN_EMAIL=admin@rlp.com.br
ADMIN_PASSWORD=Admin@123
DEMO_PASSWORD=Demo@123

BRASILAPI_BASE=https://brasilapi.com.br/api
VIACEP_BASE=https://viacep.com.br/ws
SEED_ON_BOOT=true

# OpenRouteService (km de carro EMP→PAR). Chave em https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
ORS_BASE=https://api.openrouteservice.org
ORS_HTTP_TIMEOUT_SEC=8

IA_HTTP_TIMEOUT_SEC=45

# AWS: use ../../.env.aws.* examples + docs/DEPLOY_LOCAL_AWS.md
