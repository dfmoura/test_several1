# Copie para .env e ajuste. O Compose lê .env automaticamente.

# Porta no host para ./run.sh (dev sem Docker).
APP_PORT=8097

# Porta publicada no host pelo Compose (mapeia → 8096 no container).
# Se 8096 estiver ocupada por outro projeto, use 8097 (recomendado neste workspace).
APP_HOST_PORT=8097

# Idle de sessão (minutos). Produção recomendado: 30.
AUTH_SESSION_IDLE_MINUTOS=30
AUTH_SESSION_DIAS=7
# Cookie Secure: auto | 1 | 0  (use 0 em HTTP local)
AUTH_COOKIE_SECURE=0

# Seed opcional do 1º admin (só se a tabela usuários estiver vazia).
# AUTH_BOOTSTRAP_USERNAME=admin
# AUTH_BOOTSTRAP_PASSWORD=

# HTTPS / Lightsail (profile https)
# DOMAIN=observatorio.exemplo.org
# APP_HOST_PORT=          # vazio = não publica 8096; só Caddy

# Coleta — scheduler in-process (recomendado=1 em instância única).
# Alternativa: COLETA_SCHEDULER=0 + cron em POST /api/coleta/agendamento/tick
COLETA_SCHEDULER=1
APP_VERSION=1.0.0

# CNPJ público (cadeia de fallback)
# CNPJ_PUBLICO_CACHE_DIAS=30
# CNPJ_PUBLICO_HTTP_TIMEOUT_SEC=25
# CNPJ_PUBLICO_LOTE_INTERVALO_SEC=3
# CNPJ_PUBLICO_LOTE_BACKOFF_SEC=30
# Fase 2 após coleta 07. 0 = desliga o hook.
# Na madrugada: vários lotes até ATE_HORA; de dia: 1 lote.
CNPJ_PUBLICO_POS_COLETA_LIMIT=300
CNPJ_PUBLICO_POS_COLETA_MAX_SEC=900
CNPJ_PUBLICO_POS_COLETA_ATE_HORA=06:00
CNPJ_PUBLICO_POS_COLETA_DESCANSO_SEC=60

# CEP público (cadeia de fallback)
# CEP_PUBLICO_CACHE_DIAS=90
# CEP_PUBLICO_HTTP_TIMEOUT_SEC=15

# Basemap CARTO (Leaflet — Início / Distribuição geográfica). Key gratuita.
# Exposta ao browser na URL do tile; restrinja por domínio no painel CARTO.
# CARTO_BASEMAP_API_KEY=

