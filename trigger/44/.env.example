APP_NAME=zapvia
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://localhost:8144

# Segredos — troque em qualquer ambiente compartilhado
JWT_SECRET=change-me-jwt-secret-use-64-random-chars
APP_ENCRYPTION_KEY=change-me-fernet-key-32b-urlsafe
ADMIN_TOKEN=change-me-admin-token-strong
WEBHOOK_SECRET=change-me-webhook-secret

# Billing (local = sandbox). Em hub privado ativa sozinho no 1º cadastro.
BILLING_PROVIDER=sandbox
BILLING_AUTO_ACTIVATE=true
PLAN_CODE=zapvia_pro
PLAN_NAME=ZapVia Pro
PLAN_PRICE_CENTS=9700
PLAN_CURRENCY=BRL
PLAN_INTERVAL_DAYS=30

# Caminho padrão: hub privado do operador (um site só seu).
# private + bootstrap = 1ª conta cria e fecha o cadastro.
# Alternativa SaaS: DEPLOYMENT_MODE=saas e REGISTRATION_MODE=open
DEPLOYMENT_MODE=private
REGISTRATION_MODE=bootstrap

# WhatsApp Business Cloud API (oficial). sandbox = local sem Meta.
# Pareamento QR (Baileys/Evolution) é independente — use o botão no portal.
WHATSAPP_PROVIDER=sandbox
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com

# Evolution API (QR / Baileys). No Docker a URL interna é http://evolution:8080.
EVOLUTION_URL=http://localhost:8145
EVOLUTION_KEY=change-me-evolution-key-strong
EVOLUTION_ENABLED=true

POSTGRES_PASSWORD=zapvia
RABBITMQ_PASSWORD=zapvia

DATABASE_URL=postgresql+asyncpg://zapvia:zapvia@postgres:5432/zapvia
DATABASE_URL_SYNC=postgresql://zapvia:zapvia@postgres:5432/zapvia
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://zapvia:zapvia@rabbitmq:5672/zapvia

DEFAULT_RATE_LIMIT_PER_MINUTE=30
MAX_SEND_ATTEMPTS=5
MESSAGE_RETENTION_DAYS=90
WORKER_PREFETCH=3
JWT_TTL_HOURS=168
